{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-write.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/wrong-host-build.sh" }
        ]
      },
      {
        "matcher": "Bash|Skill|Agent",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/usage-log.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/fmt-on-write.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/md-lint.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/usage-log.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/build-notify.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(xargs:*)",
      "Bash(python3:*)",
      "Bash(pip show:*)",
      "Bash(pip3 show:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh label list:*)",
      "Bash(git *)",
      "Bash(bin/vmx *)",
      "Bash(bin/wzfmt *)",
      "Bash(limactl list:*)",
      "Bash(tart list:*)",
      "WebSearch"
    ]
  }
}
