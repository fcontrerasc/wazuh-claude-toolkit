#!/usr/bin/env python3
"""wzfmt - route a C/C++ file to the formatter Wazuh CI actually uses.

Wazuh gates style with two tools over two narrow, disjoint scopes. Most of
src/ is governed by neither, and reformatting those files produces churn that
CI never asked for. This script derives both scopes from their sources at
runtime so it cannot drift:

  clang-format  <- .github/workflows/5_codelinter_clangformat.yml  (paths:)
  astyle        <- src/ci/utils.py  (MODULE_LIST + getFoldersToAStyle)
  neither       -> left alone

Usage:
  wzfmt [--check] FILE...     exit 1 if any file would change (default)
  wzfmt --write FILE...       format in place
  wzfmt --which FILE...       print the router's decision per file
  wzfmt --staged              --check over staged C/C++ files
  wzfmt --list-scope          print the derived scope tables

Exit: 0 clean or ungoverned | 1 would change | 2 tool unusable | 3 config missing
"""

import argparse
import ast
import fnmatch
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path, PurePosixPath

EXT = {".c", ".cpp", ".h", ".hpp"}

CLANG_WORKFLOW = ".github/workflows/5_codelinter_clangformat.yml"
ASTYLE_UTILS = "src/ci/utils.py"
ASTYLE_CONFIG = "src/ci/input/astyle.config"


def repo_root() -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        return Path(out)
    except (subprocess.CalledProcessError, FileNotFoundError):
        die(3, "not inside a git repository")


def die(code: int, msg: str):
    print(f"wzfmt: {msg}", file=sys.stderr)
    sys.exit(code)


def clang_scope(root: Path) -> list[str]:
    """Path prefixes the clang-format CI job gates, read from its workflow."""
    wf = root / CLANG_WORKFLOW
    if not wf.is_file():
        die(3, f"missing {CLANG_WORKFLOW}")
    prefixes = []
    in_paths = False
    for line in wf.read_text().splitlines():
        if re.match(r"^\s*paths:\s*$", line):
            in_paths = True
            continue
        if in_paths:
            m = re.match(r"^\s*-\s+(\S+)\s*$", line)
            if not m:
                if line.strip() and not line.startswith(" "):
                    break
                continue
            entry = m.group(1)
            # Only source globs matter; .clang-format and workflow self-refs do not.
            if entry.startswith("src/") and entry.endswith("/**"):
                prefixes.append(entry[: -len("/**")] + "/")
    if not prefixes:
        die(3, f"no source paths parsed from {CLANG_WORKFLOW}")
    return prefixes


def astyle_scope(root: Path) -> dict[str, list[str]]:
    """{module -> glob list} for astyle, read from src/ci/utils.py.

    MODULE_LIST gives the modules; getFoldersToAStyle gives per-module globs
    with four special cases and a default. Both are parsed, never hardcoded.
    """
    src = root / ASTYLE_UTILS
    if not src.is_file():
        die(3, f"missing {ASTYLE_UTILS}")
    tree = ast.parse(src.read_text())

    modules = None
    fn = None
    for node in tree.body:
        if isinstance(node, ast.Assign) and any(
            isinstance(t, ast.Name) and t.id == "MODULE_LIST" for t in node.targets
        ):
            modules = ast.literal_eval(node.value)
        elif isinstance(node, ast.FunctionDef) and node.name == "getFoldersToAStyle":
            fn = node
    if modules is None:
        die(3, "MODULE_LIST not found in src/ci/utils.py")
    if fn is None:
        die(3, "getFoldersToAStyle not found in src/ci/utils.py")

    def globs_of(stmts) -> list[str] | None:
        """Globs from the `foldersToScan = "...".format(moduleName)` assignment."""
        for st in stmts:
            if not isinstance(st, ast.Assign):
                continue
            if not any(
                isinstance(t, ast.Name) and t.id == "foldersToScan" for t in st.targets
            ):
                continue
            v = st.value
            if isinstance(v, ast.Call) and isinstance(v.func, ast.Attribute):
                v = v.func.value  # unwrap ".format(moduleName)"
            if isinstance(v, ast.Constant) and isinstance(v.value, str):
                return re.findall(r"\{0\}(/[^\"'\s]+)", v.value)
        return None

    # Walk the if/elif/else chain: each Compare pins one module, else is the default.
    special: dict[str, list[str]] = {}
    default: list[str] | None = None
    chain = [st for st in fn.body if isinstance(st, ast.If)]
    node = chain[0] if chain else None
    while node is not None:
        test = node.test
        if (
            isinstance(test, ast.Compare)
            and isinstance(test.comparators[0], ast.Constant)
            and (g := globs_of(node.body)) is not None
        ):
            special[test.comparators[0].value] = g
        if len(node.orelse) == 1 and isinstance(node.orelse[0], ast.If):
            node = node.orelse[0]
        else:
            default = globs_of(node.orelse)
            node = None
    if not default:
        die(3, "default astyle globs not parsed from getFoldersToAStyle")

    scope = {}
    for mod in modules:
        globs = special.get(mod, default)
        scope[f"src/{mod}"] = [f"src/{mod}{g}" for g in globs]
    return scope


def route(rel: str, clang: list[str], astyle: dict[str, list[str]]) -> str:
    if any(rel.startswith(p) for p in clang):
        return "clang-format"
    for globs in astyle.values():
        for g in globs:
            # astyle.config carries --recursive, so "mod/*.cpp" descends into every
            # subdirectory (verified against astyle 3.6.16). Match dir prefix +
            # basename pattern, at any depth.
            prefix, _, pattern = g.rpartition("/")
            if rel.startswith(prefix + "/") and fnmatch.fnmatchcase(
                PurePosixPath(rel).name, pattern
            ):
                return "astyle"
    return "none"


def clang_bin() -> str:
    """Prefer the Wazuh-pinned binary CI uses; warn when falling back to PATH."""
    pinned = os.environ.get("WAZUH_CLANG_FORMAT")
    if pinned and Path(pinned).is_file():
        return pinned
    found = shutil.which("clang-format")
    if not found:
        die(2, "clang-format not found (set WAZUH_CLANG_FORMAT or install it)")
    if not os.environ.get("WZFMT_QUIET_VERSION"):
        print(
            "wzfmt: using PATH clang-format; CI uses the Wazuh-pinned build "
            "(packages.wazuh.com/utils/clang-format). Output may differ - set "
            "WAZUH_CLANG_FORMAT to silence.",
            file=sys.stderr,
        )
    return found


def run_clang(path: Path, write: bool) -> bool:
    """True if the file is already clean."""
    cf = clang_bin()
    if write:
        subprocess.run([cf, "--style=file", "-i", str(path)], check=True)
        return True
    r = subprocess.run(
        [cf, "--style=file", "--dry-run", "-Werror", str(path)],
        capture_output=True, text=True,
    )
    if r.returncode == 0:
        return True
    formatted = subprocess.run(
        [cf, "--style=file", str(path)], capture_output=True, text=True
    ).stdout
    diff = subprocess.run(
        ["diff", "-u", str(path), "-"], input=formatted, capture_output=True, text=True
    ).stdout
    print(diff or r.stderr, end="")
    return False


def run_astyle(root: Path, path: Path, write: bool) -> bool:
    cfg = root / ASTYLE_CONFIG
    if not cfg.is_file():
        die(3, f"missing {ASTYLE_CONFIG}")
    if not shutil.which("astyle"):
        die(2, "astyle not found")
    cmd = ["astyle", f"--options={cfg}"]
    if not write:
        cmd.append("--dry-run")
    cmd.append(str(path))
    r = subprocess.run(cmd, capture_output=True, text=True)
    if "Invalid Artistic Style options" in (r.stdout + r.stderr):
        # astyle >= 3.2 rejects max-instatement-indent, which this config uses.
        # Local astyle cannot reproduce CI's result, so refuse rather than guess.
        die(
            2,
            f"local astyle rejects {ASTYLE_CONFIG} (version too new). Check it in "
            "a Linux VM instead:\n"
            "  vmx exec builder-ubuntu-arm -- bash -c "
            "'cd src && astyle --options=ci/input/astyle.config --dry-run <globs>'",
        )
    # --formatted is in the config, so a changed file is reported as "Formatted".
    changed = "Formatted" in r.stdout
    if changed and not write:
        print(r.stdout, end="")
    return not changed or write


def cpp_files(paths: list[str]) -> list[Path]:
    return [Path(p) for p in paths if Path(p).suffix in EXT]


def staged() -> list[str]:
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        capture_output=True, text=True, check=True,
    )
    return r.stdout.split()


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--which", action="store_true")
    ap.add_argument("--staged", action="store_true")
    ap.add_argument("--list-scope", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("files", nargs="*")
    a = ap.parse_args()

    if a.help:
        print(__doc__)
        return 0

    root = repo_root()
    clang = clang_scope(root)
    astyle = astyle_scope(root)

    if a.list_scope:
        print("clang-format prefixes:")
        for p in clang:
            print(f"  {p}")
        print("astyle globs:")
        for mod, globs in astyle.items():
            print(f"  {mod}: {' '.join(globs)}")
        return 0

    names = staged() if a.staged else a.files
    if not names:
        print(__doc__)
        return 0

    dirty = False
    for f in cpp_files(names):
        abs_p = (root / f) if not f.is_absolute() else f
        try:
            rel = abs_p.resolve().relative_to(root.resolve()).as_posix()
        except ValueError:
            continue  # outside the repo: not ours to format
        decision = route(rel, clang, astyle)

        if a.which:
            print(f"{decision}\t{rel}")
            continue
        if decision == "none":
            continue
        if not abs_p.is_file():
            continue

        ok = (
            run_clang(abs_p, a.write)
            if decision == "clang-format"
            else run_astyle(root, abs_p, a.write)
        )
        if not ok:
            dirty = True
            print(f"wzfmt: {rel} needs {decision}", file=sys.stderr)

    return 1 if dirty else 0


if __name__ == "__main__":
    sys.exit(main())
