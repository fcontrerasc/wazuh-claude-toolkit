#!/usr/bin/env sh
# pre-commit - run the deterministic checks on your own commits.
#
# You commit, not Claude, so this is where a check belongs: no model in the loop,
# no tokens, and it fires whether or not a session is open.
#
# Two classes, deliberately different:
#
#   docs/**/*.md   BLOCKS on the three repo rules (mdcheck --rules-only): they are
#                  reliable here and fixable in seconds. markdownlint is left out
#                  on purpose - docs written before it was wired up carry plenty of
#                  MD040/MD032 findings, and blocking on those would make
#                  --no-verify a habit. The md-lint hook covers them while editing.
#   C/C++ style    WARNS ONLY. CI's clang-format is a pinned Linux x86-64 binary
#                  and astyle >= 3.2 rejects src/ci/input/astyle.config outright,
#                  so a host verdict is advisory. Blocking on a tool that
#                  disagrees with CI would train you to pass --no-verify, which
#                  costs the doc check too.
#
# Bypass either way: git commit --no-verify
# Authoritative style check before pushing: bin/wzfmt --staged inside a Linux VM.

ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$ROOT" || exit 0

staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -n "$staged" ] || exit 0

status=0

# --- docs: blocking -------------------------------------------------------
docs="$(printf '%s\n' "$staged" | grep -E '^docs/.*\.md$' || true)"
if [ -n "$docs" ] && [ -x bin/mdcheck ]; then
    # shellcheck disable=SC2086  # word splitting is how the file list is passed
    if ! out="$(bin/mdcheck --rules-only $docs 2>&1)"; then
        printf '%s\n' "$out"
        printf '\npre-commit: doc rules failed. Fix, or: git commit --no-verify\n'
        status=1
    fi
fi

# --- C/C++ style: advisory ------------------------------------------------
if printf '%s\n' "$staged" | grep -qE '\.(c|cpp|h|hpp)$' && [ -x bin/wzfmt ]; then
    out="$(WZFMT_QUIET_VERSION=1 bin/wzfmt --staged 2>&1)"
    rc=$?
    # 1 means "would change"; 2 and 3 mean the tool cannot run here, stay quiet.
    if [ "$rc" -eq 1 ]; then
        printf 'pre-commit: style findings (advisory, host tool differs from CI):\n'
        printf '%s\n' "$out" | head -20
        printf 'Fix with: bin/wzfmt --write <file>   Authoritative: run it in a Linux VM\n'
    fi
fi

exit "$status"
